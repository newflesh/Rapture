{
  "name": "rapture",
  "version": "0.1.0",
  "description": "HTTP REST process engine that routes requests to IBM i RPG programs via Db2-for-i stored procedures",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server/index.ts",
    "test": "jest",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "js-yaml": "^4.1.0",
    "odbc": "^2.4.9",
    "path-to-regexp": "^6.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
